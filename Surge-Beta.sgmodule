#!name=Sub-Store(β)
#!desc=支持 Surge 正式版的参数设置功能. 测落地功能 ability: http-client-policy, 同步配置的定时 cronexp: 55 23 * * *
#!category=订阅管理
#!arguments=ability:http-client-policy,cronexp:55 23 * * *,sync:"# Sub-Store Sync",timeout:900,engine:auto,produce:"# Sub-Store Produce",produce_cronexp:50 */6 * * *,sync_success_notify:true,produce_sub:"sub1,sub2",produce_col:"col1,col2",max_size:-1,cors:"https://sub-store.vercel.app,http://substore.stash,https://substore.stash,https://sub.xream.eu.org,https://ahuai6.github.io",prefetch:"# Sub-Store Prefetch",prefetch_cron:"50 */6 * * *",prefetch_sub:off,prefetch_col:off,prefetch_platform:Surge
#!arguments-desc=\n1️⃣ ability\n\n默认已开启测落地能力\n需要配合脚本操作\n如 https://raw.githubusercontent.com/Keywos/rule/main/cname.js\n填写任意其他值关闭\n\n2️⃣ cronexp\n\n同步配置定时任务\n默认为每天 23 点 55 分\n\n定时任务指定时将订阅/文件上传到私有 Gist. 在前端, 叫做 '同步' 或 '同步配置'\n\n3️⃣ sync\n\n自定义定时任务名\n便于在脚本编辑器中选择\n若设为 # 可取消定时任务\n\n4️⃣ timeout\n\n脚本超时, 单位为秒\n\n5️⃣ engine\n\n默认为自动使用 webview 引擎, 可设为指定 jsc, 但 jsc 容易爆内存\n\n6️⃣ produce\n\n自定义处理订阅的定时任务名\n一般用于定时处理耗时较长的订阅, 以更新缓存\n这样 Surge 中拉取的时候就能用到缓存, 不至于总是超时\n若设为 # 可取消此定时任务\n默认不开启\n\n7️⃣ produce_cronexp\n\n配置处理订阅的定时任务\n\n默认为每 6 小时\n\n8️⃣ sync_success_notify\n\n同步配置全部成功时是否发送完成通知\n默认为 true, 填 false/0/no/off 可关闭\n\n9️⃣ produce_sub\n\n自定义需定时处理的单条订阅名\n多个用 , 连接\n\n🔟 produce_col\n\n自定义需定时处理的组合订阅名\n多个用 , 连接\n\n1️⃣1️⃣ cors\n\n允许浏览器跨域访问 Sub-Store 后端的 origin. 默认为 https://sub-store.vercel.app,http://substore.stash,https://substore.stash,https://sub.xream.eu.org,https://ahuai6.github.io. 多个用 , 连接. 设为 * 可恢复旧的任意来源访问行为, 存在钓鱼网站读取配置的风险\n\n⚠️ 注意: 是 名称(name) 不是 显示名称(displayName)\n如果名称需要编码, 请编码后再用 , 连接\n顺序: 并发执行单条订阅, 然后并发执行组合订阅\n\n定时同步、定时处理和预跑默认全部关闭, 无需填写 prefetch 参数即可安装.按需启用时, 去掉对应任务名(sync / produce / prefetch)开头的 #, 再设置目标与时间.\n\n1️⃣2️⃣ prefetch_cron\n\n全部参数均有默认值, 不需要预跑时无需填写或修改. 用来提前生成订阅, 写入输出缓存(resourceCacheTtl).\n启用: 把 prefetch 从 # Sub-Store Prefetch 改成 Sub-Store Prefetch, 按需修改 prefetch_cron(默认 50 */6 * * *), 并设置要预热的订阅名.\nprefetch_cron 为空时, 任务直接返回, 不生成订阅, 也不走同步配置.\nprefetch_sub / prefetch_col 默认 off(不选择), 仅填写需要的单条/组合订阅名(name), 多个用 , 连接.\nprefetch_platform 默认 Surge. 过期后仍会完整重算, 哈希只在 TTL 内作为缓存键.

[MITM]
hostname = %APPEND% sub.store

[Script]
Sub-Store Core=type=http-request,pattern=^https?:\/\/sub\.store\/((download)|share\/file(?:\/|\?|#|$)|api\/((?:files|wholeFiles|wholeFile|file)(?:\/|\?|#|$)|preview|sync|(?:utils\/node-info))),script-path=https://github.com/ahuai6/Sub-Store-Fork-Dist/releases/latest/download/sub-store-1.min.js,requires-body=true,timeout={{{timeout}}},ability="{{{ability}}}",engine={{{engine}}},max-size={{{max_size}}},argument="cors={{{cors}}}"

Sub-Store Simple=type=http-request,pattern=^https?:\/\/sub\.store,script-path=https://github.com/ahuai6/Sub-Store-Fork-Dist/releases/latest/download/sub-store-0.min.js,requires-body=true,timeout={{{timeout}}},engine={{{engine}}},max-size={{{max_size}}},argument="cors={{{cors}}}"

{{{sync}}}=type=cron,cronexp="{{{cronexp}}}",wake-system=1,timeout={{{timeout}}},script-path=https://github.com/ahuai6/Sub-Store-Fork-Dist/releases/latest/download/cron-sync-artifacts.min.js,engine={{{engine}}},argument="sync_success_notify={{{sync_success_notify}}}"

{{{produce}}}=type=cron,cronexp="{{{produce_cronexp}}}",wake-system=1,timeout={{{timeout}}},script-path=https://github.com/ahuai6/Sub-Store-Fork-Dist/releases/latest/download/cron-sync-artifacts.min.js,engine={{{engine}}},argument="sub={{{produce_sub}}}&col={{{produce_col}}}"
# sub-store-fork-prefetch: off while prefetch starts with # or prefetch_cron is empty
{{{prefetch}}}=type=cron,cronexp="{{{prefetch_cron}}}",wake-system=1,timeout={{{timeout}}},script-path=https://github.com/ahuai6/Sub-Store-Fork-Dist/releases/latest/download/cron-sync-artifacts.min.js,engine={{{engine}}},argument="prefetch=1&cron={{{prefetch_cron}}}&platform={{{prefetch_platform}}}&sub={{{prefetch_sub}}}&col={{{prefetch_col}}}"
